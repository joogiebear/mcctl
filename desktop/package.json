{
  "name": "mcctl-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for mcctl - a local Minecraft server dev platform",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --core ..",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "electron-builder --publish always",
    "verify": "node verify-build.mjs"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.joogiebear.mcctl",
    "productName": "mcctl",
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "core",
        "filter": [
          "mcctl.mjs",
          "src/**",
          "package.json",
          "!**/node_modules",
          "!instances/**",
          "!jars/**",
          "!backups/**",
          "!run/**",
          "!desktop/**",
          "!.git/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "mcctl",
      "artifactName": "mcctl-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "joogiebear",
        "repo": "mcctl-releases",
        "releaseType": "release"
      }
    ],
    "afterPack": "./after-pack.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
